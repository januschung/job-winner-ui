{
  "name": "job-winner-ui",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@apollo/client": "^4.3.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.15.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "dayjs": "^1.11.13",
    "graphql": "^17.0.2",
    "i18next": "^26.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.3",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "1.64.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^24.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "mock:sync": "node scripts/sync-mock-data.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src ui-tests scripts/*.mjs playwright.config.js",
    "lint:fix": "eslint src ui-tests scripts/*.mjs playwright.config.js --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\" \"ui-tests/**/*.js\" \"scripts/**/*.mjs\" docs/architecture.md README.md playwright.config.js",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css,md}\" \"ui-tests/**/*.js\" \"scripts/**/*.mjs\" docs/architecture.md README.md playwright.config.js",
    "test": "vitest --run",
    "test:ui": "playwright test --project=chromium",
    "test:ui:visual": "sh scripts/ui-tests-docker.sh --project=visual",
    "docs:media": "sh scripts/docs-media.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "ui-tests/**/*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "scripts/**/*.mjs": [
      "prettier --write",
      "eslint --fix"
    ],
    "{README.md,docs/**/*.md}": [
      "prettier --write"
    ]
  }
}
